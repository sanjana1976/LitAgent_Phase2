# Copy to .env in the project root. Never commit .env.

# Required for: python main.py chat, OpenAI-backed analysis
OPENAI_API_KEY=your-openai-api-key-here

# OPENAI_MODEL=gpt-4o
# DATABASE_PATH=./data/papers.sqlite3
# LOG_LEVEL=INFO
# PROJECT_ROOT=

# Optional API base overrides (defaults in config/config.py)
# ARXIV_API_BASE_URL=
# DBLP_API_BASE_URL=
# SEMANTIC_SCHOLAR_API_BASE_URL=
# CROSSREF_API_BASE_URL=

# Optional guardrail tool lists (comma-separated names; see design.md)
# GUARDRAILS_AUTONOMOUS_TOOLS=
# GUARDRAILS_CONFIRMATION_TOOLS=
# GUARDRAILS_BLOCKED_TOOLS=
